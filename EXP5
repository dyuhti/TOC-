#include <stdio.h>
#include <string.h>

int main() {
    char s[100];
    int i = 0, n, left = 0, right = 0;

    printf("Enter string: ");
    scanf("%s", s);

    n = strlen(s);

    while (s[i] == '0') {
        left++;
        i++;
    }

    while (s[i] == '1')
        i++;

    while (s[i] == '0') {
        right++;
        i++;
    }

    if (i == n && left == right)
        printf("Accepted\n");
    else
        printf("Rejected\n");

    return 0;
}
