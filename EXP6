#include <stdio.h>
#include <string.h>

int main() {
    char s[100];
    int i = 0, zeros = 0, ones = 0, n;

    printf("Enter string: ");
    scanf("%s", s);

    n = strlen(s);

    while (s[i] == '0') {
        zeros++;
        i++;
    }

    while (s[i] == '1') {
        ones++;
        i++;
    }

    if (i == n && zeros == ones)
        printf("Accepted\n");
    else
        printf("Rejected\n");

    return 0;
}
